# URL do servidor quando o dashboard roda em outro domínio (vazio = mesma origem / proxy do Vite)
# VITE_SERVER_URL=https://seu-servidor.com

# Fundo de mapa com chave (opcional). Sem isso, o dashboard usa satélite da Esri e OpenStreetMap, que não exigem chave.
# VITE_TILE_URL_DARK=https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key=SUA_CHAVE
# VITE_TILE_URL_LIGHT=https://api.maptiler.com/maps/dataviz/{z}/{x}/{y}.png?key=SUA_CHAVE
# VITE_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
