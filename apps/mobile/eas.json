{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://telemetria-kart.onrender.com",
        "EXPO_PUBLIC_DASHBOARD_URL": "https://telemetria-kart.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://telemetria-kart.onrender.com",
        "EXPO_PUBLIC_DASHBOARD_URL": "https://telemetria-kart.onrender.com"
      }
    }
  }
}
